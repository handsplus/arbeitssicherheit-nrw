# Resend (E-Mails: Kontakt, Beratung, optional Besuch-Benachrichtigung)
# API-Key unter https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Empfänger Kontaktformular (Standard: a.korkae@handsplus.de)
# CONTACT_FORM_EMAIL=a.korkae@handsplus.de

# Optional: Eigener Absender nach Domain-Verifizierung in Resend
# RESEND_FROM=Arbeitssicherheit.nrw <kontakt@arbeitssicherheit.nrw>

# Besuchsbenachrichtigung – standardmäßig AUS (server + client)
# VISIT_NOTIFY_ENABLED=true
# NEXT_PUBLIC_VISIT_NOTIFY_ENABLED=true

# Optional: Formspree statt Resend (wenn gesetzt, gehen Formulare an Formspree)
# NEXT_PUBLIC_FORMSPREE_BERATUNG_ID=xxxxx
# NEXT_PUBLIC_FORMSPREE_KONTAKT_ID=xxxxx

# Optional: Google Search Console Verifizierung
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
